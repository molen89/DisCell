\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Three neighbour graphs on one $160\,\mu \text  {m}$ field of the primary section, each a subset of the model's edge set. \textbf  {a},\nobreakspace  {}Edges whose segmented polygons touch. \textbf  {b},\nobreakspace  {}Edges along which the two polygons run within $1\,\mu \text  {m}$ of each other, the contact of \cref  {tab:contact}. \textbf  {c},\nobreakspace  {}The model's graph: Delaunay adjacency pruned at $40\,\mu \text  {m}$. Cells with no edge in a panel's graph are dark. The share above each panel is over the whole section, among cells with at least one edge in\nobreakspace  {}c. The field is chosen to be representative: among fields that contain both sparse and dense tissue, it is the one whose shares under a and b are closest to the section's. Edges are drawn at one width; their weights in $\beta $ are illustrated in \cref  {fig:overview}a. All panels share one scale.\relax }}{33}{figure.caption.59}\protected@file@percent }
\newlabel{fig:graph-compare}{{7}{33}{Three neighbour graphs on one $160\um $ field of the primary section, each a subset of the model's edge set. \textbf {a},~Edges whose segmented polygons touch. \textbf {b},~Edges along which the two polygons run within $1\um $ of each other, the contact of \cref {tab:contact}. \textbf {c},~The model's graph: Delaunay adjacency pruned at $40\um $. Cells with no edge in a panel's graph are dark. The share above each panel is over the whole section, among cells with at least one edge in~c. The field is chosen to be representative: among fields that contain both sparse and dense tissue, it is the one whose shares under a and b are closest to the section's. Edges are drawn at one width; their weights in $\beta $ are illustrated in \cref {fig:overview}a. All panels share one scale.\relax }{figure.caption.59}{}}
\newlabel{fig:graph-compare@cref}{{[figure][7][2147483647]7}{[1][32][]33}}
\newlabel{eq:context-closed}{{27}{33}{Why the Context Gets No Per-Edge Geometry, and Why the Graph Is Delaunay}{equation.B.27}{}}
\newlabel{eq:context-closed@cref}{{[equation][27][2147483647]27}{[1][33][]33}}
