\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Why the mask is a $25\,\mu \text  {m}$ disc, on the primary section. \textbf  {a},\nobreakspace  {}The number of cells that would stick out of a disc of radius $R$ centred on the crop anchor, from each cell's covering radius; the table gives the radii considered, the cells left outside, and the share of the $128\,\mu \text  {m}$ field each disc masks. The last row is the largest cell on the section. \textbf  {b},\nobreakspace  {}The largest cell that fits the chosen disc and \textbf  {c},\nobreakspace  {}the largest cell on the section, which does not, both drawn as the image model receives them: four channels, disc set to zero, with the cell's outline for reference. Both are elongated smooth-muscle cells.\relax }}{30}{figure.caption.46}\protected@file@percent }
\newlabel{fig:mask-radius}{{6}{30}{Why the mask is a $25\um $ disc, on the primary section. \textbf {a},~The number of cells that would stick out of a disc of radius $R$ centred on the crop anchor, from each cell's covering radius; the table gives the radii considered, the cells left outside, and the share of the $128\um $ field each disc masks. The last row is the largest cell on the section. \textbf {b},~The largest cell that fits the chosen disc and \textbf {c},~the largest cell on the section, which does not, both drawn as the image model receives them: four channels, disc set to zero, with the cell's outline for reference. Both are elongated smooth-muscle cells.\relax }{figure.caption.46}{}}
\newlabel{fig:mask-radius@cref}{{[figure][6][2147483647]6}{[1][27][]30}}
