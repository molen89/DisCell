\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces How the Voronoi face is built, and what bounds it, on the primary section. \textbf  {a},\nobreakspace  {}Segmented polygons and their centroids around a typical cell (blue). \textbf  {b},\nobreakspace  {}The polygons are set aside; each neighbour contributes the perpendicular bisector (dashed) of the segment joining the two centroids. \textbf  {c},\nobreakspace  {}The bisectors cut one another, and what survives between the cell and a neighbour is the face $f_{ij}$ (blue, length in $\mu $m); the shaded area is the cell's Voronoi region. Panels a--c share one scale. \textbf  {d},\nobreakspace  {}A dense neighbourhood and \textbf  {e},\nobreakspace  {}a cell at a tissue border, at one scale, each with the $30\,\mu \text  {m}$ clip disc (dotted). At the border the unclipped region (dashed) runs into the gap, the disc bounds it, and the dark stretch of the outline between two faces is the clip arc. \textbf  {f},\nobreakspace  {}Face length against centroid distance for every edge of the section. Clipping bounds each face by the chord $2\sqrt  {R^2-(d_{ij}/2)^2}$ of the disc, with $R = 30\,\mu \text  {m}$, and removes every edge with $d_{ij} \ge 2R$; the model keeps edges up to $40\,\mu \text  {m}$ (unshaded).\relax }}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:voronoi-face}{{S2}{7}{How the Voronoi face is built, and what bounds it, on the primary section. \textbf {a},~Segmented polygons and their centroids around a typical cell (blue). \textbf {b},~The polygons are set aside; each neighbour contributes the perpendicular bisector (dashed) of the segment joining the two centroids. \textbf {c},~The bisectors cut one another, and what survives between the cell and a neighbour is the face $f_{ij}$ (blue, length in $\mu $m); the shaded area is the cell's Voronoi region. Panels a--c share one scale. \textbf {d},~A dense neighbourhood and \textbf {e},~a cell at a tissue border, at one scale, each with the $30\um $ clip disc (dotted). At the border the unclipped region (dashed) runs into the gap, the disc bounds it, and the dark stretch of the outline between two faces is the clip arc. \textbf {f},~Face length against centroid distance for every edge of the section. Clipping bounds each face by the chord $2\sqrt {R^2-(d_{ij}/2)^2}$ of the disc, with $R = 30\um $, and removes every edge with $d_{ij} \ge 2R$; the model keeps edges up to $40\um $ (unshaded).\relax }{figure.caption.7}{}}
\newlabel{fig:voronoi-face@cref}{{[figure][2][]S2}{[1][7][]7}}
\citation{kronos2025}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Segmented-polygon contact as a spill-over kernel, against the Voronoi-face kernel $\beta $, on every section and on the model's edge set (Delaunay adjacency pruned at $40\,\mu \text  {m}$). Both kernels use the same distance decay $\qopname  \relax o{exp}(-d_{ij}/\tau )$ and the same row normalisation. The contact kernel weights an edge by the length of membrane along which the two segmented polygons run within $1\,\mu \text  {m}$ of each other; $\beta $ weights it by the Voronoi face. FF: fresh frozen. \emph  {Touching}: adjacent pairs whose polygons are at zero distance. \emph  {No spill-over}: connected cells whose kernel row is all zero, so that they receive no spill-over at any $\kappa $; \emph  {sparse} and \emph  {dense} are the lowest and highest fifth of cells by the number of centroids within $20\,\mu \text  {m}$. $\rho $: Spearman correlation, over edges, between a neighbour's share of the row and the gap between the two polygons. The Voronoi kernel has no zero-weight edges and leaves no connected cell without spill-over on any section. Its dependence on the gap is that of the distance decay alone (shares from the decay alone: $\rho $ between $-0.49$ and $-0.62$).\relax }}{8}{table.caption.8}\protected@file@percent }
\newlabel{tab:contact}{{S1}{8}{Segmented-polygon contact as a spill-over kernel, against the Voronoi-face kernel $\beta $, on every section and on the model's edge set (Delaunay adjacency pruned at $40\um $). Both kernels use the same distance decay $\exp (-d_{ij}/\tau )$ and the same row normalisation. The contact kernel weights an edge by the length of membrane along which the two segmented polygons run within $1\um $ of each other; $\beta $ weights it by the Voronoi face. FF: fresh frozen. \emph {Touching}: adjacent pairs whose polygons are at zero distance. \emph {No spill-over}: connected cells whose kernel row is all zero, so that they receive no spill-over at any $\kappa $; \emph {sparse} and \emph {dense} are the lowest and highest fifth of cells by the number of centroids within $20\um $. $\rho $: Spearman correlation, over edges, between a neighbour's share of the row and the gap between the two polygons. The Voronoi kernel has no zero-weight edges and leaves no connected cell without spill-over on any section. Its dependence on the gap is that of the distance decay alone (shares from the decay alone: $\rho $ between $-0.49$ and $-0.62$).\relax }{table.caption.8}{}}
\newlabel{tab:contact@cref}{{[table][1][]S1}{[1][7][]8}}
\newlabel{eq:context-closed}{{S8}{8}{Why the Context Gets No Per-Edge Geometry, and Why the Graph Is Delaunay}{equation.S8}{}}
\newlabel{eq:context-closed@cref}{{[equation][8][]S8}{[1][7][]8}}
