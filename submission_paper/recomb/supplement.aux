\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces The computation graph of DISCELL for one cell $i$. $\mathbf  {z}_i$ is encoded from the cell's own counts and type; $\mathbf  {c}_i$ combines attention over the neighbours' types, queried with the cell's type, with $\bm  {\Phi }_i$; $\mathbf  {w}_i$ has the prior $p(\mathbf  {w}_i \mid \mathbf  {c}_i, t_i)$ with mean $m_{\psi }$ and a posterior that also sees the cell. $\bm  {\rho }_i$ is mixed with the neighbours' clean compositions, held under a stop-gradient (sg), through $\beta $ and the fixed $\kappa $. The dashed $\breve  {\mathbf  {w}}_i$ is the prior draw of the intrinsic path. The adversary acts on $\bm  {\mu }_{z,i}$ during training; the held-out probe grades it afterwards.\relax }}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:model-detail}{{S1}{5}{The computation graph of DISCELL for one cell $i$. $\vz _i$ is encoded from the cell's own counts and type; $\vc _i$ combines attention over the neighbours' types, queried with the cell's type, with $\vPhi _i$; $\vw _i$ has the prior $p(\vw _i \mid \vc _i, t_i)$ with mean $\mpsi $ and a posterior that also sees the cell. $\vrho _i$ is mixed with the neighbours' clean compositions, held under a stop-gradient (sg), through $\beta $ and the fixed $\kappa $. The dashed $\wbreve _i$ is the prior draw of the intrinsic path. The adversary acts on $\vmu _{z,i}$ during training; the held-out probe grades it afterwards.\relax }{figure.caption.7}{}}
\newlabel{fig:model-detail@cref}{{[figure][1][]S1}{[1][4][]5}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Segmented-polygon contact as a spill-over kernel against the Voronoi-face kernel $\beta $, on the model's edge set; both use the same distance decay and row normalisation. \emph  {Touching}: adjacent polygons at zero distance; \emph  {no contact}: edges with no membrane within $1\,\mu \text  {m}$. \emph  {No spill-over}: connected cells whose contact-kernel row is all zero; \emph  {sparse}/\emph  {dense}: lowest/highest fifth of cells by centroids within $20\,\mu \text  {m}$. $\rho $: Spearman correlation over edges between a neighbour's share of the row and the gap between the polygons (decay alone: $-0.49$ to $-0.62$). The Voronoi kernel has no zero-weight edges on any section. FF: fresh frozen.\relax }}{5}{table.caption.10}\protected@file@percent }
\newlabel{tab:contact}{{S2}{5}{Segmented-polygon contact as a spill-over kernel against the Voronoi-face kernel $\beta $, on the model's edge set; both use the same distance decay and row normalisation. \emph {Touching}: adjacent polygons at zero distance; \emph {no contact}: edges with no membrane within $1\um $. \emph {No spill-over}: connected cells whose contact-kernel row is all zero; \emph {sparse}/\emph {dense}: lowest/highest fifth of cells by centroids within $20\um $. $\rho $: Spearman correlation over edges between a neighbour's share of the row and the gap between the polygons (decay alone: $-0.49$ to $-0.62$). The Voronoi kernel has no zero-weight edges on any section. FF: fresh frozen.\relax }{table.caption.10}{}}
\newlabel{tab:contact@cref}{{[table][2][]S2}{[1][5][]5}}
