\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Segmented-polygon contact as a spill-over kernel against the Voronoi-face kernel $\beta $, on the model's edge set; both use the same distance decay and row normalisation. \emph  {Touching}: adjacent polygons at zero distance; \emph  {no contact}: edges with no membrane within $1\,\mu \text  {m}$. \emph  {No spill-over}: connected cells whose contact-kernel row is all zero; \emph  {sparse}/\emph  {dense}: lowest/highest fifth of cells by centroids within $20\,\mu \text  {m}$. $\rho $: Spearman correlation over edges between a neighbour's share of the row and the gap between the polygons (decay alone: $-0.49$ to $-0.62$). The Voronoi kernel has no zero-weight edges on any section. FF: fresh frozen.\relax }}{5}{table.caption.9}\protected@file@percent }
\newlabel{tab:contact}{{S2}{5}{Segmented-polygon contact as a spill-over kernel against the Voronoi-face kernel $\beta $, on the model's edge set; both use the same distance decay and row normalisation. \emph {Touching}: adjacent polygons at zero distance; \emph {no contact}: edges with no membrane within $1\um $. \emph {No spill-over}: connected cells whose contact-kernel row is all zero; \emph {sparse}/\emph {dense}: lowest/highest fifth of cells by centroids within $20\um $. $\rho $: Spearman correlation over edges between a neighbour's share of the row and the gap between the polygons (decay alone: $-0.49$ to $-0.62$). The Voronoi kernel has no zero-weight edges on any section. FF: fresh frozen.\relax }{table.caption.9}{}}
