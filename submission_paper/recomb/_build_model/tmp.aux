\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Residual niche signal in the intrinsic latent against the cell-cycle state it keeps, per section. \emph  {Horizontal}: share of the within-type variance of neighbour composition that the held-out nonlinear probe reads from each method's intrinsic latent beyond the permutation floor, in \%. \emph  {Vertical}: $R^2$ of the cell-cycle scores from the intrinsic latent on the most strongly cycling tenth of held-out cells. The desirable corner is the top left. DISCELL: mean over three seeds, bars the range; open circle: DISCELL without the adversary. resolVI keeps a single latent and is shown as a reference. Cellina is also shown with our niche label as the domain its adversary removes (its best case on this probe), and on the TMA sections on its own neighbour graph. SIMVI ran out of memory on a 24\,GB GPU on the three larger sections, and MintFlow could not be fitted on the fresh-frozen section; both are shown where their whole-section fits exist. The values are in \cref  {tab:probe,tab:battery}. \leavevmode {\color  {violet}\textbf  {[PENDING RUNS: MintFlow refits: MintFlow's points are redrawn from the new fits]}}\relax }}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:tradeoff}{{2}{6}{Residual niche signal in the intrinsic latent against the cell-cycle state it keeps, per section. \emph {Horizontal}: share of the within-type variance of neighbour composition that the held-out nonlinear probe reads from each method's intrinsic latent beyond the permutation floor, in \%. \emph {Vertical}: $R^2$ of the cell-cycle scores from the intrinsic latent on the most strongly cycling tenth of held-out cells. The desirable corner is the top left. DISCELL: mean over three seeds, bars the range; open circle: DISCELL without the adversary. resolVI keeps a single latent and is shown as a reference. Cellina is also shown with our niche label as the domain its adversary removes (its best case on this probe), and on the TMA sections on its own neighbour graph. SIMVI ran out of memory on a 24\,GB GPU on the three larger sections, and MintFlow could not be fitted on the fresh-frozen section; both are shown where their whole-section fits exist. The values are in \cref {tab:probe,tab:battery}. \pending {MintFlow refits: MintFlow's points are redrawn from the new fits}\relax }{figure.caption.10}{}}
\newlabel{fig:tradeoff@cref}{{[figure][2][]2}{[1][5][]6}}
