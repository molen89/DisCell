\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The leading response programme of each section, in one fit. \textbf  {a},\nobreakspace  {}Territory: each cell's score, within its type (red high; the FF section is rotated), with the programme's share of $\mathbf  {w}$'s within-type variance and its within-type Moran's I. \textbf  {b},\nobreakspace  {}Signature: the five largest positive and negative gene loadings, scaled, and its two most significant hallmark labels \citep  {liberzon2015hallmark}, with the number of seeds in which the matching programme carries each among its top three at $q \leq 0.05$. \textbf  {c},\nobreakspace  {}Drivers: cross-validated $R^2$ of the score from neighbour composition, image context and distances to landmarks (vessels, smooth muscle, the tumour--stroma interface, where annotated), alone (light) and unique given the others (dark). \textbf  {d},\nobreakspace  {}Within-type Moran's I of $\mathbf  {z}$ without the adversary (two seeds), and of $\mathbf  {z}$ and $\mathbf  {w}$ in the final fits (three seeds): mean and range.\relax }}{8}{figure.caption.24}\protected@file@percent }
\newlabel{fig:programmes}{{3}{8}{The leading response programme of each section, in one fit. \textbf {a},~Territory: each cell's score, within its type (red high; the FF section is rotated), with the programme's share of $\vw $'s within-type variance and its within-type Moran's I. \textbf {b},~Signature: the five largest positive and negative gene loadings, scaled, and its two most significant hallmark labels \citep {liberzon2015hallmark}, with the number of seeds in which the matching programme carries each among its top three at $q \leq 0.05$. \textbf {c},~Drivers: cross-validated $R^2$ of the score from neighbour composition, image context and distances to landmarks (vessels, smooth muscle, the tumour--stroma interface, where annotated), alone (light) and unique given the others (dark). \textbf {d},~Within-type Moran's I of $\vz $ without the adversary (two seeds), and of $\vz $ and $\vw $ in the final fits (three seeds): mean and range.\relax }{figure.caption.24}{}}
\newlabel{fig:programmes@cref}{{[figure][3][]3}{[1][7][]8}}
